# PriceWise Environment Variables Configuration
# Copy this file to .env.local and fill in your values

# 1. Supabase Cloud Configuration (PostgreSQL, Auth & pgvector)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — strictly isolated to server-side background tasks & cron jobs
# NEVER expose this key to client-side code or public repositories
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Firecrawl Multi-Store Scraping API
FIRECRAWL_API_KEY=fc-your-firecrawl-api-key

# 3. Google Gemini / AI Provider API Key
AI_API_KEY=AIzaSy-your-gemini-api-key
GEMINI_API_KEY=AIzaSy-your-gemini-api-key

# 4. Canonical Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
